{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "pesa-yetu-api": {
      "root": "backend",
      "framework": "nestjs",
      "buildCommand": "npm run build"
    },
    "web": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "multi-media-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
