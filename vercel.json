{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "pesa-yetu-api": {
      "root": "backend",
      "framework": "nestjs",
      "buildCommand": "npm run build"
    },
    "web": {
      "root": "web",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "media center"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}